# Database connection
DATABASE_URL=postgresql://todouser:todopass@localhost:5432/tododb

# For Neon PostgreSQL, use format:
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/tododb?sslmode=require

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=your-secret-key-here-change-in-production-use-32-chars-min

# CORS configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development

# Server configuration
HOST=0.0.0.0
PORT=8000

# Phase III: AI Chatbot Configuration
# Supports multiple AI providers via OpenAI-compatible API

# Option 1: OpenAI (default)
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_API_BASE=  # Leave empty for OpenAI
# CHAT_MODEL=gpt-4o

# Option 2: Groq (free tier available) - https://console.groq.com/keys
# OPENAI_API_KEY=gsk_your-groq-api-key
# OPENAI_API_BASE=https://api.groq.com/openai/v1
# CHAT_MODEL=llama-3.3-70b-versatile

# Option 3: Ollama (local, free) - https://ollama.com
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE=http://localhost:11434/v1
# CHAT_MODEL=llama3.2

# Option 4: OpenRouter (many free models) - https://openrouter.ai/keys
# OPENAI_API_KEY=sk-or-your-openrouter-key
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# CHAT_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Conversation context limit
CONVERSATION_HISTORY_LIMIT=20
