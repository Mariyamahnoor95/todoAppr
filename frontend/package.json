{
  "name": "todo-frontend",
  "version": "2.0.0",
  "description": "Phase II - Next.js Frontend with TypeScript",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
